cabal-version:      2.4
name:               bag-of-words
version:            1.0.0
synopsis:           Motor MapReduce funcional — Bag of Words + Análisis de Sentimiento
description:
    Pipeline de procesamiento de texto en Haskell que implementa
    las operaciones Map, Filter y Fold (Reduce) sobre grandes volúmenes
    de datos, simulando la arquitectura de Apache Spark/Hadoop.
    Proyecto Unidad I — Lenguajes de Programación — UNAP.
author:             UNAP — Lenguajes de Programación
license:            MIT

-- ---------------------------------------------------------------------------
-- Biblioteca: módulos funcionales reutilizables
-- ---------------------------------------------------------------------------
library
    hs-source-dirs:   src
    exposed-modules:
        Tokenizer
        BagOfWords
        Sentiment
    build-depends:
        base       >= 4.7 && < 5
      , containers >= 0.6
    default-language: Haskell2010
    ghc-options:      -Wall -O2

-- ---------------------------------------------------------------------------
-- Ejecutable: motor principal del pipeline
-- ---------------------------------------------------------------------------
executable bag-of-words
    hs-source-dirs:   src/app
    main-is:          Main.hs
    build-depends:
        base       >= 4.7 && < 5
      , containers >= 0.6
      , bag-of-words
    default-language: Haskell2010
    ghc-options:      -Wall -O2 -threaded
